<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Learn about our mission and publishing standards.">
  <title>About Us</title>
  <style>
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#fff7ed;color:#1f2937;line-height:1.8}
    .wrap{max-width:760px;margin:auto;padding:16px}
    .card{background:#fff;border:1px solid #fed7aa;border-radius:14px;padding:16px;box-shadow:0 4px 14px rgba(0,0,0,.06)}
    a{color:#c2410c;text-decoration:none}
  </style>
</head>
<body>
  <main class="wrap">
    <section class="card">
      <h1>About Us</h1>
      <p>We are a content platform focused on delivering clear, useful, and high-quality information to visitors.</p>
      <p>We regularly review content to improve accuracy and readability across all devices.</p>
      <p>We are also committed to transparency in advertising and cookie usage.</p>
      <p><a href="index.php">Back to home</a></p>
    </section>
  </main>

  <script defer src="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js"></script>
  <script>
    window.addEventListener('load', function () {
      if (window.cookieconsent) {
        window.cookieconsent.initialise({
          palette: {
            popup: { background: '#1f2937' },
            button: { background: '#f59e0b' }
          },
          theme: 'classic',
          position: 'bottom',
          content: {
            message: 'This website uses an international cookie consent notice to meet global privacy and advertising requirements.',
            dismiss: 'Accept',
            link: 'Privacy Policy',
            href: 'privercy.html'
          }
        });
      }
    });
  </script>
</body>
</html>
